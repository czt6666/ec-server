<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.bistu.ecadmin.dao.DataSourceDao">

    <!-- 结果映射 -->
    <resultMap id="DataSourceMap" type="com.bistu.ecadmin.pojo.DataSource">
        <id property="id" column="id"/>
        <result property="name" column="name"/>
        <result property="tableName" column="table_name"/>
        <result property="status" column="status"/>
        <result property="syncFrequency" column="sync_frequency"/>
        <result property="lastSyncTime" column="last_sync_time"/>
        <result property="recordCount" column="record_count"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <!-- 查询所有数据源 -->
    <select id="findAll" resultMap="DataSourceMap">
        SELECT * FROM data_sources ORDER BY created_at DESC
    </select>

    <!-- 根据ID查询数据源 -->
    <select id="findById" resultMap="DataSourceMap">
        SELECT * FROM data_sources WHERE id = #{id}
    </select>

    <!-- 插入数据源 -->
    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO data_sources(name, table_name, status, sync_frequency, last_sync_time, record_count, created_at, updated_at)
        VALUES(#{name}, #{tableName}, #{status}, #{syncFrequency}, #{lastSyncTime}, #{recordCount}, NOW(), NOW())
    </insert>

    <!-- 更新数据源 -->
    <update id="update">
        UPDATE data_sources
        SET name = #{name},
            table_name = #{tableName},
            status = #{status},
            sync_frequency = #{syncFrequency},
            last_sync_time = #{lastSyncTime},
            record_count = #{recordCount},
            updated_at = NOW()
        WHERE id = #{id}
    </update>

    <!-- 删除数据源 -->
    <delete id="deleteById">
        DELETE FROM data_sources WHERE id = #{id}
    </delete>

    <!-- 更新数据源状态 -->
    <update id="updateStatus">
        UPDATE data_sources
        SET status = #{status},
            updated_at = NOW()
        WHERE id = #{id}
    </update>

    <!-- 根据表名动态查询表记录数 -->
    <select id="countByTableName" resultType="long">
        SELECT COUNT(*) FROM ${tableName}
    </select>
    
    <!-- 根据同步频率查找数据源 -->
    <select id="findBySyncFrequency" resultMap="DataSourceMap">
        SELECT * FROM data_sources WHERE sync_frequency = #{cronExpression} AND status = 1
    </select>

</mapper>