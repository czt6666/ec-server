<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.bistu.ecadmin.dao.mapper.OperateLogDao">

    <resultMap id="OperateLogMap" type="com.bistu.ecadmin.pojo.OperateLog">
        <id column="id" property="id"/>
        <result column="user_id" property="userId"/>
        <result column="username" property="username"/>
        <result column="operation" property="operation"/>
        <result column="method" property="method"/>
        <result column="request_params" property="requestParams"/>
        <result column="response_result" property="responseResult"/>
        <result column="ip_address" property="ipAddress"/>
        <result column="create_time" property="createTime"/>
        <result column="cost_time" property="costTime"/>
        <result column="success" property="success"/>
        <result column="error_message" property="errorMessage"/>
    </resultMap>

    <!-- 插入操作日志 -->
    <insert id="insertOperateLog" parameterType="com.bistu.ecadmin.pojo.OperateLog" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO operate_log
            (user_id, username, operation, method, request_params, response_result, ip_address, create_time, cost_time, success, error_message)
        VALUES
            (#{userId}, #{username}, #{operation}, #{method}, #{requestParams}, #{responseResult}, #{ipAddress}, #{createTime}, #{costTime}, #{success}, #{errorMessage})
    </insert>

    <!-- 分页查询操作日志 -->
    <select id="listOperateLogs" resultMap="OperateLogMap">
        SELECT * FROM operate_log
        <where>
            <if test="username != null and username != ''">
                AND username LIKE CONCAT('%', #{username}, '%')
            </if>
            <if test="operation != null and operation != ''">
                AND operation = #{operation}
            </if>
            <if test="startTime != null">
                AND create_time >= #{startTime}
            </if>
            <if test="endTime != null">
                AND create_time <![CDATA[<=]]> #{endTime}
            </if>
        </where>
        ORDER BY create_time DESC
        LIMIT #{offset}, #{limit}
    </select>

    <!-- 查询操作日志总数 -->
    <select id="countOperateLogs" resultType="int">
        SELECT COUNT(*) FROM operate_log
        <where>
            <if test="username != null and username != ''">
                AND username LIKE CONCAT('%', #{username}, '%')
            </if>
            <if test="operation != null and operation != ''">
                AND operation = #{operation}
            </if>
            <if test="startTime != null">
                AND create_time >= #{startTime}
            </if>
            <if test="endTime != null">
                AND create_time <![CDATA[<=]]> #{endTime}
            </if>
        </where>
    </select>

    <!-- 根据ID查询操作日志详情 -->
    <select id="getOperateLogById" parameterType="long" resultMap="OperateLogMap">
        SELECT * FROM operate_log WHERE id = #{id}
    </select>

</mapper>